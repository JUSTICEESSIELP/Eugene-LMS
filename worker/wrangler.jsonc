{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eugenelms",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "7fe15942e45de78396088b33436a22cf",

  // The built React SPA ships with the Worker. Only /api/* reaches the
  // Worker script; everything else is served from the asset store, with
  // client-side routes falling back to index.html.
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edunexus",
      "database_id": "2283bc0d-25a9-425f-82c0-1766f86b3b6e"
    }
  ],

  // Fallback for the AI features when no Gemini key is configured.
  "ai": { "binding": "AI" },

  "routes": [
    {
      "pattern": "eugene-lms.workplacefiles.com",
      "custom_domain": true
    }
  ],

  "observability": { "enabled": true },

  // IP-keyed leaky buckets, applied at the top of each handler before any DB or
  // email work. `POST /api/applications` is unauthenticated and now triggers an
  // outbound Resend call, so without this it is a way to make Veya send mail on
  // demand. Namespace ids are arbitrary but must stay stable.
  //
  // 10/min on the application form rather than something tighter: applicants
  // share IPs. A school open day, a sixth-form common room or a family on one
  // connection all submit from a single address, and turning legitimate
  // applicants away is a worse failure than letting someone send ten emails a
  // minute. Ten is still a hard ceiling on mail-per-minute-per-IP.
  "ratelimits": [
    {
      "name": "RL_APPLY",
      "namespace_id": "2001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_AUTH",
      "namespace_id": "2002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_RESET",
      "namespace_id": "2003",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  // RESEND_API_KEY is a secret (`wrangler secret put`), not a var. The from
  // address must sit on a domain verified in Resend.
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash",
    "RESEND_FROM": "Knowledge Tree International Institute <noreply@mail.offgridlabs.org>"
  }
}
